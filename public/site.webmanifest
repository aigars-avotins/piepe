{"name":"PIE.PE","short_name":"PIE.PE","description":"Kinematogrāfiska pastaiga mežā pie piepēm: desmit īsas filmas, interaktīvas fotogrāfijas un meža piezīmes latviski un angliski. A cinematic forest walk among bracket fungi, in Latvian and English.","lang":"lv","dir":"ltr","id":"/","start_url":"/","scope":"/","display":"browser","background_color":"#0B1712","theme_color":"#0B1712","categories":["education","entertainment"],"icons":[{"src":"/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"/icon-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"screenshots":[{"src":"/screenshots/forest-wide.jpg","sizes":"1440x900","type":"image/jpeg","form_factor":"wide","label":"Dzīvais mežs — pie.pe"},{"src":"/screenshots/forest-narrow.jpg","sizes":"390x844","type":"image/jpeg","form_factor":"narrow","label":"Dzīvais mežs — pie.pe"}]}